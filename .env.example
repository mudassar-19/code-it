# Copy to .env (git-ignored) and fill in real values locally.

# PLACEHOLDER — the site doesn't have a real production domain yet. This
# backs metadataBase (see app/layout.tsx / lib/seo.ts), the sitemap,
# robots.txt, canonical tags, and absolute OG/Twitter image URLs. Update
# this to the real domain (no trailing slash) before launch — everything
# downstream reads from this one value.
NEXT_PUBLIC_SITE_URL="https://www.codeit.com"

# System of record for leads (see lib/airtable.ts and
# /docs/airtable-setup.md for the required "Leads" table structure). Left
# empty for now — will be filled in once the Airtable account and base are
# created. Until then, the API route logs and skips the Airtable write
# rather than failing the submission.
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""

# Prisma/SQLite (see prisma/schema.prisma) — kept in the repo but no longer
# written to by /app/api/lead/route.ts now that Airtable is the system of
# record for leads. Only needed if something still runs `prisma generate`/
# migrations locally.
DATABASE_URL="file:./dev.db"

# Email (Resend — see lib/email.ts). Leave RESEND_API_KEY unset to disable
# sending locally; both email functions log and no-op instead of throwing.
RESEND_API_KEY=""
EMAIL_FROM="hello@codeit.com"
# Internal inbox that gets notified of every new "Get Started" lead.
LEAD_NOTIFICATION_EMAIL="leads@codeit.com"

# Outbound GoHighLevel sync (see lib/ghlSync.ts) — a Workflow's "Inbound
# Webhook" trigger URL, not an API key. Leave unset for now; will be filled
# in once the GoHighLevel account and workflow are set up. Until then, the
# API route logs and skips this step — nothing else in the lead flow depends
# on it.
GHL_WEBHOOK_URL=""
