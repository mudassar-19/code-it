# Copy to .env (git-ignored) and fill in real values locally.

# PLACEHOLDER — the site doesn't have a real production domain yet. This
# backs metadataBase (see app/layout.tsx / lib/seo.ts), the sitemap,
# robots.txt, canonical tags, and absolute OG/Twitter image URLs. Update
# this to the real domain (no trailing slash) before launch — everything
# downstream reads from this one value.
NEXT_PUBLIC_SITE_URL="https://www.codeit.com"

# MongoDB Atlas connection string (see prisma/schema.prisma). This is the
# single source of truth for the whole app — leads, products, categories, and
# admin users. Create a free M0 cluster at https://cloud.mongodb.com, then copy
# its "Connect → Drivers" SRV string here. Include a database name in the path
# (e.g. .../codeit?retryWrites=true&w=majority). Never commit the real value —
# this file is a placeholder only.
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codeit?retryWrites=true&w=majority"

# NextAuth (admin panel auth — see lib/auth.ts). NEXTAUTH_SECRET signs the
# session JWTs; generate one with:  openssl rand -base64 32
# NEXTAUTH_URL is the app's base URL (http://localhost:3000 in dev; the real
# https origin in production).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# First admin user, consumed only by `npm run seed:admin` (scripts/seed-admin.ts).
# ADMIN_PASSWORD_HASH must be a bcrypt hash, NOT a plaintext password — generate
# one with:  npm run hash-password -- "your-strong-password"
# ADMIN_NAME is optional (defaults to "Admin"). Never commit real values.
ADMIN_EMAIL="admin@codeit.com"
ADMIN_PASSWORD_HASH=""
ADMIN_NAME="Admin"

# Email notifications (Resend — see lib/email.ts). A FREE Resend account is
# enough: the free tier allows 100 emails/day. Create one at
# https://resend.com, then create an API key and paste it below.
# Leave RESEND_API_KEY unset to disable sending locally — both email functions
# log what they *would* send and no-op instead of throwing, so a missing key
# never blocks a lead from being saved.
RESEND_API_KEY=""
# The "from" address on outgoing mail. Until you verify your own domain in
# Resend, you can use their onboarding sender "onboarding@resend.dev". Once your
# domain is verified, switch this to something like "hello@yourdomain.com".
EMAIL_FROM="onboarding@resend.dev"
# Internal inbox that receives a notification for every new lead. Required for
# the internal notification to send (the confirmation to the lead only needs
# RESEND_API_KEY).
LEAD_NOTIFICATION_EMAIL="you@example.com"

# Outbound GoHighLevel sync (see lib/ghlSync.ts) — a Workflow's "Inbound
# Webhook" trigger URL, not an API key. Leave unset for now; will be filled
# in once the GoHighLevel account and workflow are set up. Until then, the
# API route logs and skips this step — nothing else in the lead flow depends
# on it.
GHL_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# Phase 2
# ---------------------------------------------------------------------------

# Cloudinary media uploads (see lib/cloudinary.ts). A FREE Cloudinary account
# is enough — no paid tier needed. Create one at https://cloudinary.com, then
# copy these three values from your Dashboard (Account Details / API Keys).
# Used only by the admin-only upload route (app/api/admin/upload); the secret
# never reaches the browser. If any are unset, the upload route returns a clear
# 503 and the rest of the app keeps working.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cal.com booking embed (see components/CalendarPlaceholder.tsx). Create a FREE
# Cal.com account at https://cal.com, set up an event type, and paste your
# scheduling link here — either the full URL
# (https://cal.com/your-name/intro-call) or just the slug (your-name/intro-call).
# If unset, the "Book a Consultation" section shows a graceful fallback message
# instead of a broken embed. This is a NEXT_PUBLIC_ var — it's exposed to the
# browser by design (it's just your public booking link).
NEXT_PUBLIC_CAL_LINK=""
